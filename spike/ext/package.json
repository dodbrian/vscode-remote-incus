{
  "name": "remote-incus-spike",
  "displayName": "Remote - Incus (Spike)",
  "description": "Phase-0 spike: connect VS Code to an Incus container over exec-stdio (no sshd)",
  "publisher": "local-spike",
  "version": "0.0.2",
  "private": true,
  "license": "SEE LICENSE IN ../../DESIGN.md",
  "engines": {
    "vscode": "^1.140.0"
  },
  "extensionKind": [
    "ui"
  ],
  "main": "./extension.js",
  "enabledApiProposals": [
    "resolvers",
    "contribViewsRemote"
  ],
  "activationEvents": [
    "onResolveRemoteAuthority:incus-spike",
    "onView:remote-incus-spike.instances"
  ],
  "contributes": {
    "views": {
      "remote": [
        {
          "id": "remote-incus-spike.instances",
          "name": "Incus (Spike)",
          "group": "targets@1"
        }
      ]
    },
    "commands": [
      {
        "command": "remote-incus-spike.connectToInstance",
        "title": "Connect",
        "category": "Remote - Incus (Spike)",
        "icon": "$(arrow-right)"
      },
      {
        "command": "remote-incus-spike.startInstance",
        "title": "Start",
        "category": "Remote - Incus (Spike)",
        "icon": "$(debug-start)"
      },
      {
        "command": "remote-incus-spike.stopInstance",
        "title": "Stop",
        "category": "Remote - Incus (Spike)",
        "icon": "$(debug-stop)"
      },
      {
        "command": "remote-incus-spike.refresh",
        "title": "Refresh",
        "category": "Remote - Incus (Spike)",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "remote-incus-spike.refresh",
          "when": "view == remote-incus-spike.instances",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "remote-incus-spike.connectToInstance",
          "when": "view == remote-incus-spike.instances && viewItem == instance-running",
          "group": "inline@1"
        },
        {
          "command": "remote-incus-spike.startInstance",
          "when": "view == remote-incus-spike.instances && viewItem == instance-stopped",
          "group": "inline@1"
        },
        {
          "command": "remote-incus-spike.stopInstance",
          "when": "view == remote-incus-spike.instances && viewItem == instance-running",
          "group": "inline@2"
        }
      ]
    }
  }
}
