{
  "name": "remote-incus",
  "displayName": "Remote - Incus",
  "description": "Connect to Incus containers as a first-class remote connection type (exec-stdio transport, no sshd).",
  "publisher": "local-dev",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://example.invalid/local-dev/remote-incus"
  },
  "engines": {
    "vscode": "^1.140.0"
  },
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "main": "./dist/extension.js",
  "enabledApiProposals": [
    "resolvers",
    "contribViewsRemote"
  ],
  "activationEvents": [
    "onResolveRemoteAuthority:incus",
    "onView:remote-incus.instances"
  ],
  "contributes": {
    "views": {
      "remote": [
        {
          "id": "remote-incus.instances",
          "name": "Incus",
          "group": "targets@1",
          "remoteName": "incus"
        }
      ]
    },
    "commands": [
      {
        "command": "remote-incus.connectToInstance",
        "title": "Connect in Current Window...",
        "category": "Remote - Incus",
        "icon": "$(arrow-right)"
      },
      {
        "command": "remote-incus.connectToInstanceInNewWindow",
        "title": "Connect in New Window...",
        "category": "Remote - Incus",
        "icon": "$(empty-window)"
      },
      {
        "command": "remote-incus.connectToFolder",
        "title": "Connect in Current Window...",
        "category": "Remote - Incus",
        "icon": "$(arrow-right)"
      },
      {
        "command": "remote-incus.connectToFolderInNewWindow",
        "title": "Connect in New Window...",
        "category": "Remote - Incus",
        "icon": "$(empty-window)"
      },
      {
        "command": "remote-incus.removeFolderFromHistory",
        "title": "Remove Recent Folder",
        "category": "Remote - Incus",
        "icon": "$(close)"
      },
      {
        "command": "remote-incus.startInstance",
        "title": "Start",
        "category": "Remote - Incus",
        "icon": "$(debug-start)"
      },
      {
        "command": "remote-incus.stopInstance",
        "title": "Stop",
        "category": "Remote - Incus",
        "icon": "$(debug-stop)"
      },
      {
        "command": "remote-incus.restartInstance",
        "title": "Restart",
        "category": "Remote - Incus",
        "icon": "$(debug-restart)"
      },
      {
        "command": "remote-incus.openTerminal",
        "title": "Open Terminal (exec)",
        "category": "Remote - Incus",
        "icon": "$(terminal)"
      },
      {
        "command": "remote-incus.killServer",
        "title": "Kill VS Code Server on Instance",
        "category": "Remote - Incus"
      },
      {
        "command": "remote-incus.uninstallServer",
        "title": "Uninstall from Instance",
        "category": "Remote - Incus"
      },
      {
        "command": "remote-incus.resetToken",
        "title": "Reset Server & Connection Token",
        "category": "Remote - Incus"
      },
      {
        "command": "remote-incus.collectDiagnostics",
        "title": "Collect Diagnostics",
        "category": "Remote - Incus"
      },
      {
        "command": "remote-incus.showLog",
        "title": "Show Log",
        "category": "Remote - Incus"
      },
      {
        "command": "remote-incus.refresh",
        "title": "Refresh",
        "category": "Remote - Incus",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "remote-incus.connectToInstance",
          "when": "false"
        },
        {
          "command": "remote-incus.connectToInstanceInNewWindow",
          "when": "false"
        },
        {
          "command": "remote-incus.connectToFolder",
          "when": "false"
        },
        {
          "command": "remote-incus.connectToFolderInNewWindow",
          "when": "false"
        },
        {
          "command": "remote-incus.removeFolderFromHistory",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "remote-incus.refresh",
          "when": "view == remote-incus.instances",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "remote-incus.connectToFolder",
          "when": "view == remote-incus.instances && viewItem == instance-folder",
          "group": "inline@1"
        },
        {
          "command": "remote-incus.connectToFolder",
          "when": "view == remote-incus.instances && viewItem == instance-folder",
          "group": "navigation@1"
        },
        {
          "command": "remote-incus.connectToFolderInNewWindow",
          "when": "view == remote-incus.instances && viewItem == instance-folder",
          "group": "inline@2"
        },
        {
          "command": "remote-incus.connectToFolderInNewWindow",
          "when": "view == remote-incus.instances && viewItem == instance-folder",
          "group": "navigation@2"
        },
        {
          "command": "remote-incus.removeFolderFromHistory",
          "when": "view == remote-incus.instances && viewItem == instance-folder",
          "group": "inline@3"
        },
        {
          "command": "remote-incus.connectToInstance",
          "when": "view == remote-incus.instances && viewItem =~ /instance-(running|stopped)/",
          "group": "inline@1"
        },
        {
          "command": "remote-incus.connectToInstance",
          "when": "view == remote-incus.instances && viewItem =~ /instance-(running|stopped)/",
          "group": "navigation@1"
        },
        {
          "command": "remote-incus.connectToInstanceInNewWindow",
          "when": "view == remote-incus.instances && viewItem =~ /instance-(running|stopped)/",
          "group": "inline@2"
        },
        {
          "command": "remote-incus.connectToInstanceInNewWindow",
          "when": "view == remote-incus.instances && viewItem =~ /instance-(running|stopped)/",
          "group": "navigation@2"
        },
        {
          "command": "remote-incus.startInstance",
          "when": "view == remote-incus.instances && viewItem == instance-stopped",
          "group": "remote-incus@1"
        },
        {
          "command": "remote-incus.stopInstance",
          "when": "view == remote-incus.instances && viewItem == instance-running",
          "group": "remote-incus@2"
        },
        {
          "command": "remote-incus.restartInstance",
          "when": "view == remote-incus.instances && viewItem == instance-running",
          "group": "remote-incus@3"
        },
        {
          "command": "remote-incus.openTerminal",
          "when": "view == remote-incus.instances && viewItem == instance-running",
          "group": "remote-incus@4"
        },
        {
          "command": "remote-incus.killServer",
          "when": "view == remote-incus.instances && viewItem == instance-running",
          "group": "remote-incus@5"
        },
        {
          "command": "remote-incus.resetToken",
          "when": "view == remote-incus.instances && viewItem == instance-running",
          "group": "remote-incus@6"
        },
        {
          "command": "remote-incus.uninstallServer",
          "when": "view == remote-incus.instances && viewItem =~ /instance-(running|stopped)/",
          "group": "remote-incus@7"
        }
      ]
    },
    "configuration": {
      "title": "Remote - Incus",
      "properties": {
        "remote-incus.user": {
          "type": "string",
          "default": "default",
          "scope": "application",
          "description": "User to attach as inside the instance. \"default\" = the instance's primary unprivileged user; \"root\" = explicit root attach; otherwise an exact username or numeric uid.",
          "pattern": "^(default|root|[a-z_][a-z0-9_-]*$|[0-9]+$)"
        },
        "remote-incus.downloadUrlTemplate": {
          "type": "string",
          "default": "https://update.code.visualstudio.com/commit:{commit}/server-{flavor}/stable",
          "scope": "application",
          "description": "Client-route URL template for the VS Code server tarball ({commit}, {flavor}). Override for mirrors; auto uses client transfer directly for custom mirrors."
        },
        "remote-incus.downloadStrategy": {
          "type": "string",
          "enum": [
            "auto",
            "client",
            "container"
          ],
          "enumDescriptions": [
            "Try verified container download first, then visibly fall back once to client download and transfer. Custom mirrors use client transfer directly.",
            "Always download on the client and transfer through Incus; no container internet or curl required.",
            "Only download in the container using curl and the expected Microsoft SHA-256. Failures do not fall back. Custom mirrors require auto or client."
          ],
          "default": "auto",
          "scope": "application",
          "description": "How to obtain a missing VS Code server archive. Complete installations skip download work for either strategy."
        }
      }
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tests/tsconfig.json",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "npx --yes @vscode/vsce@latest package --allow-missing-repository -o remote-incus.vsix",
    "test": "node tests/build.cjs",
    "test:relay": "node scripts/verify-relay.cjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "1.140.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.5.0"
  }
}
