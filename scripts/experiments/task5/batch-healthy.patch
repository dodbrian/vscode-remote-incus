+/** EXPERIMENT ONLY: healthy fast path, otherwise the unchanged baseline flow. */
 async function doEnsureServerReady(context: vscode.ExtensionContext, ref: InstanceRef, report?: Report): Promise<ServerSession> {
+  report?.('experimental batched snapshot…');
+  const identity = await resolveIdentity(ref);
+  const commit = await resolveClientCommit();
+  const installDir = `${identity.home}/${VS_SERVER_DIR}/bin/${commit}`;
+  // The install probe must NOT put the plain process-match string in argv:
+  // root pgrep runs concurrently and would otherwise match this probe shell.
+  const mainFile = `${sq(`${installDir}/out`)}/'server'-main.js`;
+  const [selected, root] = await Promise.all([
+    execInInstance(ref, [
+      'kill -0 $$ && echo yes || echo no',
+      `printf '\\nINCUS_FLAVOR\\n'`,
+      'uname -m; ldd --version 2>&1 | head -1',
+      `printf '\\nINCUS_INSTALL\\n'`,
+      `if [ -f ${sq(`${installDir}/.incus-installing`)} ]; then echo no;`,
+      `elif [ -x ${sq(`${installDir}/bin/code-server`)} ] && [ -f ${mainFile} ] && [ -x ${sq(`${installDir}/node`)} ]; then echo yes;`,
+      'else echo no; fi',
+    ].join('\n'), { uid: identity.uid, home: identity.home }),
+    execInInstance(ref, [
+      `pgrep -af 'serv[e]r-main\\.js' || true`,
+      `printf '\\nINCUS_HEALTH\\n'`,
+      `test -x ${sq(`${installDir}/bin/code-server`)} && test -f ${sq(logPath(identity.home))} && test -s ${sq(tokenPath(identity.home))} && echo yes || echo no`,
+    ].join('\n')),
+  ]);
+  // Barrier: no token, relay, install, kill or startup mutation before both
+  // immutable pre-repair snapshots have completed.
+  const [signal, rest = ''] = selected.split('\nINCUS_FLAVOR\n');
+  const [flavorText, installed = ''] = rest.split('\nINCUS_INSTALL\n');
+  const [processes, healthy = ''] = root.split('\nINCUS_HEALTH\n');
+  const running = [...processes.matchAll(/bin\/([0-9a-f]{40})\//g)].map(m => m[1].toLowerCase())[0];
+  if (signal.trim() !== 'yes' || installed.trim() !== 'yes' || running !== commit || healthy.trim() !== 'yes') {
+    log('experimental batching fallback: pre-repair snapshot is not reusable');
+    return doEnsureServerReadyBaseline(context, ref, report);
+  }
+  const [arch = '', lddLine = ''] = flavorText.split('\n').map(line => line.trim());
+  let flavor: ServerFlavor;
+  if (/musl/i.test(lddLine)) {
+    if (arch !== 'x86_64') throw new Error(`unsupported instance: musl on ${arch} — no upstream VS Code server build exists (arm64 requires glibc)`);
+    flavor = 'linux-alpine';
+  } else if (arch === 'x86_64') flavor = 'linux-x64';
+  else if (arch === 'aarch64') flavor = 'linux-arm64';
+  else throw new Error(`unsupported instance architecture: ${arch}`);
+
+  const localRelay = path.join(context.asAbsolutePath('.'), 'assets', 'relay.js');
+  const hash = await sha256File(localRelay);
+  const relay = sq(relayPath(identity.home));
+  const relayMatches = [
+    `test -f ${relay} && test ! -L ${relay}`,
+    `test "$(sha256sum ${relay} 2>/dev/null | cut -d' ' -f1)" = ${sq(hash)}`,
+    `test "$(stat -c '%u:%g:%a' ${relay} 2>/dev/null)" = ${sq(`${identity.uid}:${identity.gid}:600`)}`,
+  ].join(' && ');
+  const dir = `${identity.home}/${VS_SERVER_DIR}/data/Machine`;
+  report?.('experimental batched preparation/readiness…');
+  const final = await execInInstance(ref, [
+    `set -e`,
+    `mkdir -p ${sq(dir)}`,
+    `if [ ! -s ${sq(tokenPath(identity.home))} ]; then`,
+    `  ( umask 077`,
+    `    tr -dc A-Za-z0-9 < /dev/urandom | head -c 43 > ${sq(tokenPath(identity.home))}.tmp`,
+    `    test "$(wc -c < ${sq(tokenPath(identity.home))}.tmp)" -eq 43`,
+    `    mv ${sq(tokenPath(identity.home))}.tmp ${sq(tokenPath(identity.home))} )`,
+    `  echo 'fresh token minted'`,
+    `else`,
+    `  echo 'token already exists (sticky reuse)'`,
+    `fi`,
+    `chmod 600 ${sq(tokenPath(identity.home))}`,
+    `if ${relayMatches}; then`,
+    `  echo relay-current`,
+    `else`,
+    // Unlink the path before push can follow it and overwrite another file.
+    `  if [ -L ${relay} ]; then rm -- ${relay}; fi`,
+    `  test ! -d ${relay}`,
+    `  echo relay-repair`,
+    `fi`,
+  ].join('\n') + '\n' + [
+    `if ${relayMatches}; then`,
+    `  printf '\\nINCUS_SESSION\\n'`,
+    `  grep -s "Extension host agent listening on" ${sq(logPath(identity.home))} || true`,
+    `  printf '\\nINCUS_TOKEN\\n'`,
+    `  cat ${sq(tokenPath(identity.home))}`,
+    'fi',
+  ].join('\n'), { uid: identity.uid, home: identity.home });
+  const framed = final.split('\nINCUS_SESSION\n');
+  if (framed.length !== 2) {
+    log('experimental batching fallback: relay requires repair');
+    return doEnsureServerReadyBaseline(context, ref, report);
+  }
+  const [announcements, tokenText = ''] = framed[1].split('\nINCUS_TOKEN\n');
+  const hits = [...announcements.matchAll(/Extension host agent listening on (\d+)/g)];
+  if (!hits.length) {
+    log('experimental batching fallback: readiness requires bounded polling');
+    return doEnsureServerReadyBaseline(context, ref, report);
+  }
+  const token = tokenText.trim();
+  if (!token) throw new Error('could not read the connection token from the instance');
+  const port = Number(hits[hits.length - 1][1]);
+  report?.('ready', 100);
+  log('experimental batched healthy reuse ready');
+  return { ref, identity, commit, flavor, port, token };
+}
